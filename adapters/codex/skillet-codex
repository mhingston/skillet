#!/bin/sh
set -eu
: "${SKILLET_MCP_URL:=http://localhost:8080/mcp}"
: "${SKILLET_CODEX_SKILLS_DIR:=${HOME}/.codex/skills}"
if [ "${1:-}" = "lifecycle" ]; then shift; exec skillet-client lifecycle -server "$SKILLET_MCP_URL" -source codex "$@"; fi
if [ "${1:-}" = "feedback" ]; then shift; exec skillet-client feedback -server "$SKILLET_MCP_URL" -source codex "$@"; fi
[ "$#" -ge 1 ] || { echo "usage: skillet-codex <selector> | lifecycle <lifecycle options> | feedback <feedback options>" >&2; exit 2; }
selector="$1"
if [ "${selector#*@}" != "$selector" ]; then sel="${selector#*@}"; if [ "${sel#^}" != "$sel" ]; then exec skillet-client materialize -server "$SKILLET_MCP_URL" -skill-id "${selector%%@*}" -range "$sel" -destination "$SKILLET_CODEX_SKILLS_DIR"; else exec skillet-client materialize -server "$SKILLET_MCP_URL" -skill-id "${selector%%@*}" -version "$sel" -destination "$SKILLET_CODEX_SKILLS_DIR"; fi; fi
exec skillet-client materialize -server "$SKILLET_MCP_URL" -candidate "$selector" -destination "$SKILLET_CODEX_SKILLS_DIR"
